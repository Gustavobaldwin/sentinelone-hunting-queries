{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SentinelOne hunting query",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","title","title_pt","description","description_pt","author","version","status","operating_system","mitre","query","false_positives","created","updated"],
  "properties": {
    "id": {"type": "string", "pattern": "^S1H-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 5},
    "title_pt": {"type": "string", "minLength": 5},
    "description": {"type": "string", "minLength": 20},
    "description_pt": {"type": "string", "minLength": 20},
    "author": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["experimental", "tested", "production", "deprecated"]},
    "operating_system": {"enum": ["windows", "linux", "macos", "any"]},
    "mitre": {
      "type": "object", "additionalProperties": false,
      "required": ["tactic", "techniques"],
      "properties": {
        "tactic": {"enum": ["reconnaissance","resource-development","initial-access","execution","persistence","privilege-escalation","defense-evasion","credential-access","discovery","lateral-movement","collection","command-and-control","exfiltration","impact"]},
        "techniques": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}}
      }
    },
    "query": {"type": "string", "minLength": 10},
    "false_positives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tuning": {"type": "array", "items": {"type": "string"}},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "references": {"type": "array", "items": {"type": "string", "format": "uri"}}
  }
}
